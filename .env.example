# SatQuery AI - Environment Configuration

# Anthropic Claude API Key for live Vision LLM inference (e.g. claude-3-7-sonnet-20250219, claude-3-5-sonnet-latest)
# If left empty, SatQuery AI runs in built-in Remote Sensing Domain Simulation mode (ideal for offline/hackathon judging demos)
ANTHROPIC_API_KEY=

# Anthropic Claude Model Identifier (optional, default: claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Server Port (optional, default: 8000)
PORT=8000
